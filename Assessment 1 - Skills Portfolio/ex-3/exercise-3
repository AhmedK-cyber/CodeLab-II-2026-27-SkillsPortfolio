        tk.Label(dlg, text=head, font=(FONT, 12, "bold"), bg=BG, fg=TITLE).pack(pady=(14, 4))
        for o in opts:
            tk.Radiobutton(dlg, text=o, variable=var, value=o, font=(FONT, 11), bg=BG, fg=FG, activebackground=BG, selectcolor=CARD).pack(anchor="w", padx=95)
    row = tk.Frame(dlg, bg=BG); row.pack(pady=16)
