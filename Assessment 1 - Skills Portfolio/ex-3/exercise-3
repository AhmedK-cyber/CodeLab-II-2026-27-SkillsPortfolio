    PillButton(row, "Cancel", dlg.destroy, 105, 34, NEUTRAL, NEUTRAL_H, FG).pack(side="left", padx=4)
    dlg.wait_visibility(); dlg.grab_set(); root.wait_window(dlg)
    if not res["v"]:
        return
    field, order = res["v"]
    keys = {"Name": lambda s: s["name"].lower(), "Number": lambda s: s["code"], "Percentage": pct}
    show_table(f"Sorted by {field} ({order})", sorted(students, key=keys[field], reverse=(order == "Descending")))


def _int_range(val, lo, hi, lbl):
    # Checks that a value is a whole number inside the allowed range.
    try:
        n = int(val.strip())
    except ValueError:
        raise ValueError(f"{lbl} must be a whole number.")
    if not (lo <= n <= hi):
        raise ValueError(f"{lbl} must be between {lo} and {hi}.")
    return n


def _validate(vals, existing=None):
    # Checks number from 1000-9999 (not already used), name (1-20 letters, no
    # commas), coursework marks (0-20), and exam mark (0-100).
    try:
        code = _int_range(vals[0], 1000, 9999, "Student number")
        name = vals[1].strip()
        if not name or "," in name or len(name) > 20:
            raise ValueError("Name must be 1-20 characters with no commas.")
        marks = [_int_range(vals[i + 2], 0, 20, f"Coursework {i + 1}") for i in range(3)]
        exam = _int_range(vals[5], 0, 100, "Exam mark")
    except ValueError as err:
        return None, str(err)
    for s in students:
        if s["code"] == code and s is not existing:
            return None, f"Student number {code} already belongs to {s['name']}."
    return {"code": code, "name": name, "marks": marks, "exam": exam}, ""

def _form(title, existing=None, focus=None):
    # Opens the add/update form and waits until saved or closed.
    win = tk.Toplevel(root)
    win.title(title); win.configure(bg=BG); win.geometry("410x540"); win.resizable(False, False); win.transient(root)
    tk.Label(win, text=title, font=(FONT, 14, "bold"), bg=BG, fg=TITLE).pack(pady=(14, 6))
    labels = ["Student Number (1000-9999)", "Name (max 20 chars)", "Coursework 1 (0-20)",
              "Coursework 2 (0-20)", "Coursework 3 (0-20)", "Exam Mark (0-100)"]
    init = [str(existing["code"]), existing["name"], *(str(m) for m in existing["marks"]), str(existing["exam"])] if existing else [""] * 6
    boxes = []
    for lbl, val in zip(labels, init):
        tk.Label(win, text=lbl, font=(FONT, 10, "bold"), bg=BG, fg=FG).pack(anchor="w", padx=46, pady=(6, 1))
        e = tk.Entry(win, font=(FONT, 11), width=28, bg=CARD, fg=FG, relief="solid", bd=1)
        e.insert(0, val); e.pack(padx=46, ipady=2); boxes.append(e)
    if focus is not None:
        boxes[focus].focus_set()
    out_data = {"v": None}

    def on_save():
        # Keeps the form open if something is wrong so the user can fix it.
        data, err = _validate([b.get() for b in boxes], existing)
        if err:
            messagebox.showerror("Invalid Input", err, parent=win); return
        out_data["v"] = data; win.destroy()

    bar = tk.Frame(win, bg=BG); bar.pack(pady=16)
    PillButton(bar, "Save", on_save, 125, 35, GREEN, GREEN_H).pack(side="left", padx=5)
    PillButton(bar, "Cancel", win.destroy, 105, 35, NEUTRAL, NEUTRAL_H, FG).pack(side="left", padx=5)
    win.wait_visibility(); win.grab_set(); root.wait_window(win)
    return out_data["v"]


def add_student():
    # Menu 6: adds a new student and saves to studentMarks.txt.
    rec = _form("Add Student Record")
    if rec:
        students.append(rec); save_students(); show_table("Student Added", [rec])


def update_student():
    # Menu 7th: lets the user pick which field to update in a small menu,
    # edits the student, and saves to studentMarks.txt.
    target = pick_single()
    if not target:
        return
    dlg = tk.Toplevel(root)
    dlg.title("Update Field"); dlg.configure(bg=BG); dlg.geometry("330x370"); dlg.resizable(False, False); dlg.transient(root)
    choice, picked = tk.StringVar(value="All Details"), {"v": None}
    tk.Label(dlg, text=f"Update: {target['name']}", font=(FONT, 12, "bold"), bg=BG, fg=TITLE).pack(pady=(14, 6))
    opts = ["All Details", "Student Number", "Name", "Coursework 1", "Coursework 2", "Coursework 3", "Exam Mark"]
    for o in opts:
        tk.Radiobutton(dlg, text=o, variable=choice, value=o, font=(FONT, 10), bg=BG, fg=FG, activebackground=BG, selectcolor=CARD).pack(anchor="w", padx=90)
    row = tk.Frame(dlg, bg=BG); row.pack(pady=14)
    PillButton(row, "Continue", lambda: (picked.update({"v": choice.get()}), dlg.destroy()), 115, 34, BLUE, BLUE_H).pack(side="left", padx=4)
    PillButton(row, "Cancel", dlg.destroy, 100, 34, NEUTRAL, NEUTRAL_H, FG).pack(side="left", padx=4)
    dlg.wait_visibility(); dlg.grab_set(); root.wait_window(dlg)
    if not picked["v"]:
        return
    idx_map = {"Student Number": 0, "Name": 1, "Coursework 1": 2, "Coursework 2": 3, "Coursework 3": 4, "Exam Mark": 5}
    upd = _form("Update Student Record", target, idx_map.get(picked["v"]))
    if upd:
        target.update(upd); save_students(); show_table("Student Updated", [target])


def delete_student():
    # Menu 8th: asks to confirm, removes the student, and saves the file.
    target = pick_single()
    if target and messagebox.askyesno("Delete Record", f"Delete {target['name']} ({target['code']})?", parent=root):
        students.remove(target); save_students(); show_msg("Student Deleted", f"{target['name']} ({target['code']}) deleted.")


