# ---------- interactive buttons ----------
class RoundButton(tk.Canvas):

    def __init__(self, parent, text, command, width, height, color,
                 hover_color, text_color="black", font=("Arial", 14, "bold")):
        self.pad = 10   
        tk.Canvas.__init__(self, parent, width=width + 2 * self.pad,
                           height=height + 2 * self.pad, bg=BG,
                           highlightthickness=0, cursor="hand2")
        self.text = text
        self.command = command
        self.btn_width = width
        self.btn_height = height
        self.color = color
        self.hover_color = hover_color
        self.text_color = text_color
        self.font = font
        self.enabled = True
        self.hovering = False

        self.bind("<Enter>", self.onEnter)
        self.bind("<Leave>", self.onLeave)
        self.bind("<ButtonRelease-1>", self.onClick)
        self.draw()

    def roundRect(self, x1, y1, x2, y2, fill):
        # Half the height is used as the corner size, which makes the ends circular.
        r = (y2 - y1) / 2
        points = [x1 + r, y1, x1 + r, y1, x2 - r, y1, x2 - r, y1,
                  x2, y1, x2, y1 + r, x2, y1 + r, x2, y2 - r,
                  x2, y2 - r, x2, y2, x2 - r, y2, x2 - r, y2,
                  x1 + r, y2, x1 + r, y2, x1, y2, x1, y2 - r,
                  x1, y2 - r, x1, y1 + r, x1, y1 + r, x1, y1]
        self.create_polygon(points, smooth=True, fill=fill, outline=fill)

    def draw(self):
        # hovering effect of the button where the button grows
        self.delete("all")
        x1 = self.pad
        y1 = self.pad
        x2 = x1 + self.btn_width
        y2 = y1 + self.btn_height

        if not self.enabled:
            fill = DISABLED
            grow = 0
        elif self.hovering:
            fill = self.hover_color
            grow = 4
        else:
            fill = self.color
            grow = 0

        if grow > 0:
            self.roundRect(x1 - grow + 3, y1 - grow + 4,
                           x2 + grow + 3, y2 + grow + 4, SHADOW)
        self.roundRect(x1 - grow, y1 - grow, x2 + grow, y2 + grow, fill)
        self.create_text((x1 + x2) / 2, (y1 + y2) / 2, text=self.text,
                         fill=self.text_color, font=self.font)

    def onEnter(self, event):
        self.hovering = True
        self.draw()

    def onLeave(self, event):
        self.hovering = False
        self.draw()

    def onClick(self, event):
        # The click only counts if the mouse is still on the button.
        inside = 0 <= event.x <= self.winfo_width() and 0 <= event.y <= self.winfo_height()
        if self.enabled and inside:
            self.command()

    def enable(self):
        self.enabled = True
        self.config(cursor="hand2")
        self.draw()

    def disable(self):
        self.enabled = False
        self.hovering = False
        self.config(cursor="arrow")
        self.draw()
