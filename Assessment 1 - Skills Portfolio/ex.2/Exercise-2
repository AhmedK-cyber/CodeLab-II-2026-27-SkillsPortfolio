# This button closes the program.
RoundButton(root, "Quit", root.destroy, 160, 44, RED, RED_HOVER).pack(pady=(20, 10))

# ---------- setup ----------
# Load the jokes when the program starts.
# Look for randomJokes.txt in the program's folder and read the jokes from
# it if it is found.
# If the file is missing or has no jokes in it, use the built-in jokes instead.
# The message in the console shows which one was used.
jokes = []
joke_path = findJokeFile()
if joke_path:
    jokes = loadJokes(joke_path)
    print("Loaded " + str(len(jokes)) + " jokes from " + joke_path)

if len(jokes) == 0:
    jokes = parseJokes(BUILT_IN_JOKES)
    print("No jokes found in randomJokes.txt, using the built-in jokes")

# Keep the window open until the user closes it.
root.mainloop()