# ---------- interactive buttons ----------
class RoundButton(tk.Canvas):

    def __init__(self, parent, text, command, width, height, color,
                 hover_color, text_color="black", font=("Arial", 14, "bold")):
        self.pad = 10   
        tk.Canvas.__init__(self, parent, width=width + 2 * self.pad,
                           height=height + 2 * self.pad, bg=BG,
                           highlightthickness=0, cursor="hand2")
        self.text = text
        self.command = command
        self.btn_width = width
        self.btn_height = height
        self.color = color
        self.hover_color = hover_color
        self.text_color = text_color
        self.font = font
        self.enabled = True
        self.hovering = False

        self.bind("<Enter>", self.onEnter)
        self.bind("<Leave>", self.onLeave)
        self.bind("<ButtonRelease-1>", self.onClick)
        self.draw()

    def roundRect(self, x1, y1, x2, y2, fill):
        # Half the height is used as the corner size, which makes the ends circular.
        r = (y2 - y1) / 2
        points = [x1 + r, y1, x1 + r, y1, x2 - r, y1, x2 - r, y1,
                  x2, y1, x2, y1 + r, x2, y1 + r, x2, y2 - r,
                  x2, y2 - r, x2, y2, x2 - r, y2, x2 - r, y2,
                  x1 + r, y2, x1 + r, y2, x1, y2, x1, y2 - r,
                  x1, y2 - r, x1, y1 + r, x1, y1 + r, x1, y1]
        self.create_polygon(points, smooth=True, fill=fill, outline=fill)

    def draw(self):
        # hovering effect of the button where the button grows
        self.delete("all")
        x1 = self.pad
        y1 = self.pad
        x2 = x1 + self.btn_width
        y2 = y1 + self.btn_height

        if not self.enabled:
            fill = DISABLED
            grow = 0
        elif self.hovering:
            fill = self.hover_color
            grow = 4
        else:
            fill = self.color
            grow = 0

        if grow > 0:
            self.roundRect(x1 - grow + 3, y1 - grow + 4,
                           x2 + grow + 3, y2 + grow + 4, SHADOW)
        self.roundRect(x1 - grow, y1 - grow, x2 + grow, y2 + grow, fill)
        self.create_text((x1 + x2) / 2, (y1 + y2) / 2, text=self.text,
                         fill=self.text_color, font=self.font)

    def onEnter(self, event):
        self.hovering = True
        self.draw()

    def onLeave(self, event):
        self.hovering = False
        self.draw()

    def onClick(self, event):
        # The click only counts if the mouse is still on the button.
        inside = 0 <= event.x <= self.winfo_width() and 0 <= event.y <= self.winfo_height()
        if self.enabled and inside:
            self.command()

    def enable(self):
        self.enabled = True
        self.config(cursor="hand2")
        self.draw()

    def disable(self):
        self.enabled = False
        self.hovering = False
        self.config(cursor="arrow")
        self.draw()


# ---------- joke logic ----------
def findJokeFile():
    # Looks for randomJokes.txt in the program's folder and returns its full
    # path, or None if it is not there.
    for name in os.listdir(JOKE_FOLDER):
        if name.lower() == "randomjokes.txt":
            return os.path.join(JOKE_FOLDER, name)
    return None


def parseJokes(text):
    # Turns text into a list of (setup, punchline) pairs.
    # Each line is one joke, and the setup and punchline are joined together
    # with no space after the question mark.
    # For every line, find the FIRST question mark. Everything up to and
    # including it is the setup, and everything after it is the punchline.
    # Using the first one matters because a punchline could also have a "?".
    # Skip empty lines and any line with no question mark.
    result = []
    for line in text.splitlines():
        line = line.strip()
        position = line.find("?")
        if position == -1:
            continue
        setup = line[:position + 1]
        punchline = line[position + 1:].strip()
        result.append((setup, punchline))
    return result


def loadJokes(path):
    # Reads the joke file and returns its jokes using parseJokes.
    # utf-8-sig is used because it also copes with a hidden marker that some
    # editors add at the start of a file, and symbols like "…" are read correctly.
    with open(path, "r", encoding="utf-8-sig", errors="replace") as file:
        text = file.read()
    return parseJokes(text)


def tellJoke():
    # Used by the "Alexa tell me a Joke" and "Next Joke" buttons.
    # Picks a random joke from the list so user wont see the same joke twice in a row.
    # Show only the setup and clear the old punchline.
    # Turn on "Show Punchline" and "Next Joke" so they can be used.
    global current_joke

    joke = random.choice(jokes)
    while joke == current_joke and len(jokes) > 1:
        joke = random.choice(jokes)
    current_joke = joke

    setup_label.config(text=current_joke[0])
    punchline_label.config(text="")
    punchline_button.enable()
    next_button.enable()


def showPunchline():
    # Shows the punchline of the current joke under the setup.
    if current_joke is None:
        return
    punchline_label.config(text=current_joke[1])
    punchline_button.disable()


